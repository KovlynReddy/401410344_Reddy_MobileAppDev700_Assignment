<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">
    <TextView android:id="@+id/tvRecipeName" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="28sp" android:textStyle="bold" android:layout_marginBottom="16dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Ingredients Needed:" android:textStyle="bold"/>
    <TextView android:id="@+id/tvIngredients" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Preparation Steps:" android:textStyle="bold"/>
    <TextView android:id="@+id/tvSteps" android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>
